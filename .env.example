# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never carry a real value. Every key below is read by name somewhere in the
# code -- see the file named against each one.
#
#     cp .env.example .env

# --- Telegram --------------------------------------------------------------
# From @BotFather. tg.py refuses to send without it and says so; it is never
# logged, and API errors are reported without echoing the token.
TELEGRAM_BOT_TOKEN=

# Who is allowed to talk to the bot. One id, or several separated by commas.
# tg.py checks EVERY incoming message against this list. An empty value is
# treated as "nobody", not "everybody" -- an unset allowlist once served all.
TELEGRAM_CHAT_ID=

# --- Upstox (live quotes only; the backtest needs none of this) -------------
# src/core/live_source.py reads this to fetch a live price for a fill. It expires
# roughly daily, which is why the fill retries hourly rather than failing the
# day. Absent, live_source.py falls through to its other providers.
UPSTOX_ACCESS_TOKEN=

# Only needed to MINT the token above with `python3 src/ops/upstox_login.py`.
# Skip all three if you paste an access token in by hand.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=

# --- Which strategy is live ------------------------------------------------
# Read by paths.py, defaults to sprout, and normally passed per command rather
# than set here: STRATEGY=other python3 src/ops/audit.py
# Setting it in .env makes every command in every shell use it, which is the
# quiet way to audit one strategy while believing you audited another.
# STRATEGY=sprout

# Nimble Web API (optional). Key NAME only -- the value never belongs in git.
# Without it, nimble.available() is False and callers degrade rather than fail.
NIMBLE_API_KEY=
# Override only if your account uses the older endpoint
# (api.webit.live/api/v1/realtime/web) instead of the documented v2 one.
NIMBLE_ENDPOINT=
