{
  "$comment": "Checked in and shared. settings.local.json stays gitignored for personal overrides. The deny list is the part that matters: every entry is a rule this repo already learned the hard way.",
  "permissions": {
    "allow": [
      "Bash(python3 tests/run_selftests.py)",
      "Bash(python3 src/ops/audit.py)",
      "Bash(python3 src/ops/overview.py)",
      "Bash(python3 src/ops/daily.py:*)",
      "Bash(python3 src/strategies/sprout/clusters.py)",
      "Bash(env -u PYTHONPATH python3:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./data/upstox_token.json)",
      "Bash(git push:*)",
      "Edit(./data/sprout/strategies.jsonl)",
      "Edit(./data/sprout/trade_features.jsonl)",
      "Edit(./data/sprout/findings.jsonl)",
      "Edit(./data/positions.db)",
      "Bash(rm:*)"
    ]
  }
}
