# Raw NSE payloads: 293MB and growing, refetchable via backfill.py.
# The manifests are what make a backtest reproducible, not the bytes.
data/raw/
data/journal.db
data/cron.log

# Keep: holidays.json and judge_ledger.json are derived state that must not be
# silently regenerated -- the ledger is the audit trail of holdout consultations.
!data/holidays.json
!data/judge_ledger.json

__pycache__/
*.pyc
.venv/
.env

# Upstox instrument master: 9,650 rows, refetchable, changes only with listings.
data/upstox_instruments.json

# --- macOS and editor junk -------------------------------------------------
.DS_Store
*.bak

# --- runtime state: regenerated every agent tick, never read as evidence ---
# These churned in almost every commit and say nothing a reader needs. The
# agent rewrites them constantly; git history of them is noise.
data/agent*.log
data/telegram.log
data/audit.log
data/DIGEST.md
data/agent_state.json
data/agent_heartbeat.json
data/agent.lock
data/tg_offset.json

# --- XBRL filings: 40,775 files, 84% of the repo, and no measured signal ---
# Four company-momentum features across 1,049 randomly sampled trades: every
# confidence interval straddles zero (CLAUDE.md). The score does not read them
# and features.attach_fundamentals treats absence as normal -- 15% of the
# universe has no filings at all.
#
# NOT refetchable while www.nseindia.com blocks us, so the local 1.6GB copy is
# the only one. It stays on disk; this only stops it being pushed.
data/fundamentals/

# Kept deliberately: pbook.db is the record of real forward trades and cannot
# be regenerated from anything. findings/strategies/simulations/walkforward
# jsonl, the baselines and holidays.json are evidence, not runtime state.

# Pre-migration copies of the order record. Kept on disk, never committed.
data/positions.db.bak-*

# Claude Code's per-machine permission grants. Tracking it made a local tool
# setting a repo change, and because the sandbox may not write this path a
# branch switch could not check it out -- which is what blocked a fast-forward
# for three attempts while the working tree sat on the wrong version of tg.py.
.claude/settings.local.json

# iCloud conflict copies ("DIGEST 2.md", "agent_state 2.json"). Nothing reads
# them; they are stale snapshots that show up as untracked changes.
* 2.*
