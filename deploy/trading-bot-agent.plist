<?xml version="1.0" encoding="UTF-8"?>
<!--
  The self-running agent. ONE schedule replaces the daily/weekly pair.
  Runs hourly and does only what is outstanding, so it is safe to run twice and
  catches up after the machine was asleep.

  That difference matters here: a fixed 19:00 job on a sleeping machine misses
  the session permanently, because NSE publishes surveillance state for the
  current day only. An agent that asks "is today's snapshot missing?" simply
  does it on the next wake.

  Install (replaces trading-bot-daily / -weekly / -pipeline):
    cp deploy/trading-bot-agent.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/trading-bot-agent.plist

  Never passes --consult: holdout budget is spent by a person who means it.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sudhanshu.tradingbot.agent</string>
  <key>WorkingDirectory</key>
  <string>/Users/sudhanshukushwaha/Documents/Repo/trading-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>/usr/local/bin/python3 agent.py --once --telegram</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <!--
    Plus a fixed tick just after the open. The hourly interval alone fires on
    the hour, and the fill is only allowed from 09:20 (the open is 09:15 and
    the day's bar has to print first) -- so the earliest hourly tick that could
    fill was 10:00, three quarters of an hour late. The fill PRICE is the day's
    open either way, so this buys visibility, not accuracy.

    Both keys are honoured: hourly AND at fixed weekday times.

    The hourly StartInterval alone is not enough. Observed 2026-08-18: the job
    fired four times after a reload and then stopped for five hours, so the
    evening run -- fills, P&L, re-ranking, tomorrow's picks -- would have been
    missed entirely. Fixed ticks do not depend on that timer surviving.

      09:25  fill what /next_orders holds, once the open has printed
      18:10  the evening run; NSE publishes the bhavcopy after 18:00
      19:10  backup, in case 18:10 landed while the machine was asleep

    Weekend entries are omitted because nothing is due then.
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key>
  <string>/Users/sudhanshukushwaha/Documents/Repo/trading-bot/data/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sudhanshukushwaha/Documents/Repo/trading-bot/data/agent.log</string>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
