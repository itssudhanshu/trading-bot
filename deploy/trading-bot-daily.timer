[Unit]
Description=Run NSE snapshot on weekday evenings (IST)

[Timer]
# 19:00 Mon-Fri in the machine's local timezone. Set the box to Asia/Kolkata,
# or change this to the equivalent local hour -- NSE closes 15:30 IST and the
# bhavcopy lands well after.
OnCalendar=Mon..Fri 19:00
Persistent=true

[Install]
WantedBy=timers.target
