<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly research pass: search -> walk-forward -> aggregate.

  Deliberately does NOT consult the holdout. The judge has a 50-consultation
  lifetime budget; spending it should be a decision, never a side effect of a
  scheduled job. This produces data/promoted.jsonl and a report; a human decides
  what, if anything, is worth a consultation.

  Saturday 09:00 -- markets shut, machine likely awake.

  Install:
    cp deploy/com.sudhanshu.tradingbot.weekly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.sudhanshu.tradingbot.weekly.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sudhanshu.tradingbot.weekly</string>
  <key>WorkingDirectory</key>
  <string>/Users/sudhanshukushwaha/Documents/Repo/trading-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>./weekly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/sudhanshukushwaha/Documents/Repo/trading-bot/data/weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sudhanshukushwaha/Documents/Repo/trading-bot/data/weekly.log</string>
</dict>
</plist>
